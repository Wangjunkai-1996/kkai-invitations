# Invitations 邀请返利系统配置示例
# 复制此文件为 .env 并填写实际值

# ============================================================
# Session 配置
# ============================================================
# 必须与 new-api 的 SESSION_SECRET 环境变量相同
# 用于解析 new-api 的 session cookie
SESSION_SECRET=your-new-api-session-secret-here

# ============================================================
# 数据库配置
# ============================================================
# Invitations 数据库（读写）
# 存储返利规则、返利记录、提现申请等数据
DATABASE_URL=postgresql://user:password@localhost/invitations

# new-api 数据库（只读）
# 用于同步订单数据（subscriptions、topups）
NEWAPI_DATABASE_URL=postgresql://user:password@localhost/newapi

# ============================================================
# 服务配置
# ============================================================
# 监听地址
LISTEN_ADDR=0.0.0.0:6212

# 路径前缀（留空，由 nginx 处理路径重写）
# 如果需要自定义前缀，可以设置为 /invitations 等
BASE_PATH=

# ============================================================
# 日志配置
# ============================================================
# 日志级别：trace, debug, info, warn, error
# 开发环境建议使用 debug，生产环境使用 info
RUST_LOG=info
