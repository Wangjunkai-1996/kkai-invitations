# Invitations 邀请返利系统配置示例
# 复制此文件为 .env 并填写实际值

# ============================================================
# Session 配置
# ============================================================
# 必须与 new-api 的 SESSION_SECRET 环境变量相同
# 用于解析 new-api 的 session cookie
SESSION_SECRET=your-new-api-session-secret-here

# 系统同步接口密钥
# 手动调用 /api/system/sync-rebates 时需要通过 X-Sync-Secret 或 Bearer token 提供
SYNC_SECRET=change-this-random-sync-secret

# ============================================================
# 数据库配置
# ============================================================
# Invitations 数据库（读写）
# 存储返利规则、返利记录、提现申请等数据
DATABASE_URL=postgresql://user:password@localhost/invitations

# new-api 数据库（只读）
# 用于同步订单数据（subscription_orders、top_ups）
NEWAPI_DATABASE_URL=postgresql://user:password@localhost/newapi

# ============================================================
# 服务配置
# ============================================================
# 监听地址
LISTEN_ADDR=0.0.0.0:6212

# 路径前缀（留空，由 nginx 处理路径重写）
# 如果需要自定义前缀，可以设置为 /invitations 等
BASE_PATH=

# 内置自动同步间隔，默认 3600 秒（每小时一次）；设置为 0 可关闭内置自动同步
AUTO_SYNC_INTERVAL_SECONDS=3600

# 服务启动后首次自动同步延迟，默认 10 秒
AUTO_SYNC_INITIAL_DELAY_SECONDS=10

# 资金结算模式：disabled（默认）、read_only 或 enabled
# 缺失/空值会安全降级为 disabled；无效值会阻止服务启动
# read_only 保留查询接口，但所有发放、冲正和批量审批发放请求返回 HTTP 423
# 旧 PAYOUT_ENABLED 已废弃且不会开启资金写入
SETTLEMENT_MODE=disabled

# ============================================================
# 日志配置
# ============================================================
# 日志级别：trace, debug, info, warn, error
# 开发环境建议使用 debug，生产环境使用 info
RUST_LOG=info
